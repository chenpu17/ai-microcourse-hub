generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum SubmissionStatus {
  NEW
  NEED_FOLLOW_UP
  SCHEDULED
  REJECTED
  ARCHIVED
}

model TalkSubmission {
  id            String           @id @default(cuid())
  topic         String
  speakerName   String
  durationLabel String
  note          String?
  status        SubmissionStatus @default(NEW)
  adminComment  String?
  contactResult String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model MicroCourse {
  id                 String               @id @default(cuid())
  slug               String               @unique
  title              String
  speakerName        String
  durationLabel      String
  eventDate          DateTime?
  startTime          String?
  endTime            String?
  summary            String
  replayUrl          String
  materialsUrl       String
  publishedAt        DateTime
  cardColorType      String
  speakerBio         String
  takeawaysText      String
  feedbackQuotesText String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  tags               MicroCourseTag[]
  relatedFrom        MicroCourseRelated[] @relation("CourseRelatedFrom")
  relatedTo          MicroCourseRelated[] @relation("CourseRelatedTo")
}

model MicroCourseTag {
  id      Int         @id @default(autoincrement())
  tagName String
  courseId String
  course   MicroCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model MicroCourseRelated {
  id              Int         @id @default(autoincrement())
  courseId        String
  relatedCourseId String
  course          MicroCourse @relation("CourseRelatedFrom", fields: [courseId], references: [id], onDelete: Cascade)
  relatedCourse   MicroCourse @relation("CourseRelatedTo", fields: [relatedCourseId], references: [id], onDelete: Cascade)

  @@unique([courseId, relatedCourseId])
}
